# Peer-dep resolution:
#   react-native-nitro-modules declares strict peer-dep ranges that clash
#   with the exact react-native version pinned here. Nothing is actually
#   broken at runtime — the ranges are just narrower than reality.
#   `legacy-peer-deps=true` tells npm/EAS to warn instead of failing,
#   which mirrors what `npm install --legacy-peer-deps` did locally.
#   Without this flag, EAS's `npm ci` demands every peer be locked,
#   producing "Missing: @react-native/babel-preset@0.86.3 from lock file"
#   even though the packages resolve fine at build time.
legacy-peer-deps=true
