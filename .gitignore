# Python virtual environments — never commit these
backend/venv/
backend/.venv/
**/__pycache__/
**/*.py[cod]
**/*.pyo

# Local SQLite dev databases
backend/*.db
backend/*.sqlite

# Claude runtime state
.claude/scheduled_tasks.lock
.claude/scheduled_tasks/

# Node dependencies
**/node_modules/

# Expo local build artifacts
**/.expo/
**/dist/
**/android/
**/ios/

# Environment secrets
**/.env
*.env.local

# Logs
**/*.log

# OS files
.DS_Store
Thumbs.db
