# ─── KisanShakti monorepo .gitignore ──────────────────────────────────────
# Ordered by category. Anything committed by accident before this file
# existed must be removed with `git rm --cached <path>` — .gitignore
# doesn't retroactively untrack.

# ─── Environment secrets (NEVER commit) ─────────────────────────────────
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
!**/.env.sample
*.env.bak

# ─── Python ─────────────────────────────────────────────────────────────
backend/venv/
backend/.venv/
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/htmlcov/
**/.coverage
**/coverage.xml

# ─── Local SQLite dev databases (production uses managed DB) ────────────
backend/*.db
backend/*.sqlite
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm
# Exception: the app-bundled disease treatments DB SHIPS with the APK
!apps/upaj/assets/disease_treatments.db
!apps/upaj/assets/*.db

# ─── Backend runtime artefacts ──────────────────────────────────────────
backend/uploads/**
!backend/uploads/.gitkeep
backend/logs/
**/*.log
**/*.bak
**/*.old

# ─── AI training checkpoints, scratch scripts + intermediate files ──────
backend/ai/_ckpt/
backend/ai/_*
backend/ai/*.log
backend/ai/*.h5
backend/ai/*.keras
backend/ai/*.bak
apps/upaj/assets/models/*.tflite.bak
apps/upaj/assets/models/*.tflite.old

# ─── Node / Expo ────────────────────────────────────────────────────────
**/node_modules/
**/.expo/
**/.expo-shared/
**/dist/
**/web-build/
**/.next/
**/build/

# ─── Native build outputs (regenerated by EAS / gradle / xcode) ─────────
**/android/build/
**/android/app/build/
**/android/.gradle/
**/ios/build/
**/ios/Pods/
**/ios/*.xcworkspace/xcuserdata/
**/*.jks
**/*.keystore
!**/debug.keystore

# ─── EAS local artefacts ────────────────────────────────────────────────
**/eas-build-local-nodejs/
**/.easignore.local

# ─── Claude Code runtime ────────────────────────────────────────────────
.claude/scheduled_tasks.lock
.claude/scheduled_tasks/
.claude/local/

# ─── Editor / OS junk ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json.example
.idea/
*.iml

# ─── Datasets we shouldn't ship (too big; download separately) ──────────
PlantDoc-Dataset/
