# KisanShakti backend — environment template.
# Copy this to backend/.env and fill each value. NEVER commit the real .env.

# ── Database ────────────────────────────────────────────────────────────
# Local dev: SQLite file in the backend/ directory (default if unset).
# Production: swap for a Postgres URL, e.g.
#   postgresql://user:pass@host:5432/kisanshakti
DATABASE_URL=sqlite:///./kisanshakti_dev.db

# ── JWT auth ────────────────────────────────────────────────────────────
# Signs every login token. MUST be >= 32 characters. Rotate if leaked —
# rotating invalidates every logged-in farmer + buyer session (they re-OTP).
# Generate a fresh one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-real-random-string-at-least-32-chars-long

# ── Third-party API keys ────────────────────────────────────────────────
# OpenWeather — https://openweathermap.org/api  (free tier is fine)
# When missing, the app falls back to Open-Meteo (keyless) automatically.
WEATHER_API_KEY=

# AGMARKNET — https://data.gov.in/resource/current-daily-price-various-commodities-various-markets-mandi
# Only used for the "Show all-India" toggle. Karnataka data comes from
# the keyless KMV scraper regardless of this key.
AGMARKNET_API_KEY=

# ── Debug flags ─────────────────────────────────────────────────────────
# When true, /api/v1/auth/send-otp returns the OTP in the response so dev
# builds can auto-fill it (no SMS provider wired up yet). MUST be false
# in production.
DEBUG=true
